{
  "name": "dongui-bogam",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build-cloudflare.cjs",
    "dev:cloudflare": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run --outdir .worker-build",
    "test:cloudflare": "node --test tests/worker.test.mjs tests/worker-runtime.cjs tests/work-assistant.test.mjs tests/law-mcp.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261123.1-beta",
    "pdfjs-dist": "6.5.438",
    "wrangler": "4.168.0"
  }
}
