{
  "name": "dongui-bogam", "private": true, "version": "1.0.0", "engines": {"node": ">=22"},
  "scripts": {
    "build": "node scripts/build-cloudflare.cjs",
    "dev:cloudflare": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "check:cloudflare": "npm run build && wrangler deploy --dry-run --outdir .worker-build",
    "test:cloudflare": "node --test tests/worker.test.mjs"
  },
  "dependencies": {"fast-xml-parser": "5.12.1"},
  "devDependencies": {"wrangler": "4.168.0"}
}
