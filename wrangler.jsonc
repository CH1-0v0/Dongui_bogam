{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dongui-bogam",
  "main": "backend/cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "run_worker_first": true},
  // MCP connection settings are reserved; retrieval integration is not implemented yet.
  "vars": {
    "OPENROUTER_MODEL": "openai/gpt-6-luna",
    "LAW_MCP_URL": "https://mcp.gomdori.app/law",
    "LAW_MCP_ENABLED": "true"
  },
  "ratelimits": [
    {"name": "AI_LIMITER", "namespace_id": "1001", "simple": {"limit": 6, "period": 60}},
    {"name": "API_LIMITER", "namespace_id": "1002", "simple": {"limit": 60, "period": 60}}
  ],
  "observability": {"enabled": true, "logs": {"enabled": true}}
}
